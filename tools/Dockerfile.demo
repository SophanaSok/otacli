# Records the README demo GIF. Build from the repository root:
#   docker build -f tools/Dockerfile.demo -t otacli-vhs .
FROM ghcr.io/charmbracelet/vhs:latest

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-venv python3-pip chafa mpv megatools ca-certificates wget \
    && rm -rf /var/lib/apt/lists/*

# match install.sh: current yt-dlp, so the environment check shows green
RUN wget -q https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -O /usr/local/bin/yt-dlp \
 && chmod a+rx /usr/local/bin/yt-dlp

COPY run.py /app/run.py
COPY src /app/src

RUN python3 -m venv /app/.venv \
 && /app/.venv/bin/pip install --quiet requests inquirerpy termcolor pillow rich curl-cffi

# the real launcher, so the recording shows the command users actually type
RUN printf '#!/bin/bash\ncd /app && exec /app/.venv/bin/python run.py\n' > /usr/local/bin/otacli \
 && chmod +x /usr/local/bin/otacli

WORKDIR /app
